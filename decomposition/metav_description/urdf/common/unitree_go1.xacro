<?xml version="1.0"?>
<robot name="unitree_go1_motor_macro" xmlns:xacro="http://www.ros.org/wiki/xacro">
   
    <xacro:macro name="unitree_go1_motor" params="joint_name motor_id mechanical_reduction:=1.0 offset:=0.0 kp:=0.1 kd:=0.01">
        <joint name="${joint_name}">
                <command_interface name="position"/>
                <command_interface name="velocity"/>
                <command_interface name="effort"/>
                <state_interface name="position" />
                <state_interface name="velocity" />
                <state_interface name="effort" />
                <param name="motor_id">${motor_id}</param>
                <param name="mechanical_reduction">${mechanical_reduction}</param>
                <param name="offset">${offset}</param>
                <param name="kp">${kp}</param>
                <param name="kd">${kd}</param>
            </joint>
    </xacro:macro>

</robot>